{
  "name": "crossover",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "plan": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/plan.ts",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "api-test": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/api-test.ts",
    "e2e": "playwright test",
    "ollama:setup": "ollama create crossover-gpt-oss -f ollama/Modelfile",
    "revalidate": "node --import tsx scripts/revalidate.ts",
    "eval": "node --import tsx scripts/eval.ts",
    "calibrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/calibrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
