# Copy to .env.local and fill in. Never commit real values.

# Qloo hackathon API (X-Api-Key header). Without a key the app runs in fixture mode on synthetic data.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# live | fixture  (defaults to live when QLOO_API_KEY is set)
CROSSOVER_MODE=

# Language model.
#   anthropic  Claude (needs LLM_API_KEY or ANTHROPIC_API_KEY; default model claude-opus-5-5)
#   ollama     local Ollama server, open-weights models, $0 (default http://localhost:11434/v1,
#              model crossover-gpt-oss: run `ollama pull gpt-oss:20b` then `npm run ollama:setup`)
#   openai     any OpenAI-compatible API: Groq, Together, Fireworks, OpenRouter, vLLM, LM Studio
#              (needs LLM_BASE_URL and LLM_MODEL; LLM_API_KEY if the host requires one)
#   none       deterministic templated writer, no model
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# reasoning_effort for open reasoning models: low | medium | high | off (Ollama default: low)
LLM_REASONING_EFFORT=
# Price per million tokens for cost logging. Needed for hosted open models; Claude and Ollama are built in.
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
# Wall-clock budget per run (default 60 s; 240 s for Ollama)
RUN_WALL_SECONDS=

# Quota protection for judging
QLOO_QUOTA_FLOOR=1500
QLOO_MAX_CALLS_PER_RUN=36
LIVE_RUNS_PER_IP_HOUR=6

# Proxies in front of the app that append to X-Forwarded-For (1 for Render/Railway/Vercel).
TRUSTED_PROXY_HOPS=1
